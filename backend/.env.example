# Copy to backend/.env — these configure the FastAPI service itself.
# Pipeline settings (GEMINI_API_KEY, QDRANT_PATH, EMBEDDING_MODEL, ...)
# live in ../rag/.env — see rag/.env.example.

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Reject uploads larger than this before they reach the ingestion pipeline.
MAX_UPLOAD_MB=25
