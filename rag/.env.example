# ── Copy this file to .env and fill in your values ──────────────────
# Run: cp .env.example .env
#
# There is nothing REQUIRED here. Every setting below has a working
# default in config.py; this file only exists to override them.
#
# NOTE: this file used to declare GEMINI_API_KEY as "Required". No module
# in this package imports google-genai or reads that variable — every LLM
# call goes to a local Ollama server (see OLLAMA_* in config.py). The key
# was never used, and asking for it implied a cloud dependency that does
# not exist.

# ── LLM (Ollama) ────────────────────────────────────────────────────
# Both models must be pulled locally: `ollama pull qwen2.5:3b` and
# `ollama pull qwen2.5:14b`. Raise OLLAMA_NUM_PARALLEL on the server
# (default 1) or the IRAC reranker's concurrent calls will serialize.
# OLLAMA_HOST=http://localhost:11434

# ── Paths ───────────────────────────────────────────────────────────
# Resolved relative to this rag/ directory regardless of process CWD —
# safe to leave relative even when this package is imported from
# ../backend rather than run standalone. Give an absolute path to point
# somewhere else entirely.
# QDRANT_PATH=qdrant_db
# COLLECTION_NAME=legal_sections
# CSV_PATH=data/dataset.csv
# JSON_PATH=data/final_dataset.json
# BM25_VOCAB_PATH=data/bm25_vocab.json
# BM25_IDF_PATH=data/bm25_idf.json
# ONTOLOGY_PATH=data/legal_elements_ontology.json
